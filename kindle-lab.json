            "id": "menclose-longdiv",
            "group": "MathML",
            "name": "menclose notation=\"longdiv\"",
            "summary": "One menclose drawn as long division anywhere in the book turns the whole book into a fixed page: it opens, but the font size cannot be changed and the page reads like a PDF. Amazon lists menclose as supported and mlongdiv as unsupported.",
            "workaround": "Give every menclose an explicit notation other than longdiv (box works), or replace it with mrow.",
            "test_books": [
                {
                    "slug": "menclose-longdiv",
                    "filename": "kindle-lab-menclose-longdiv.epub",
